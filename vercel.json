{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "true",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/chat", "destination": "/", "permanent": false },
    { "source": "/chat/:path*", "destination": "/", "permanent": false }
  ]
}
